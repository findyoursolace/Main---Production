{%- comment -%} ============================================================
  STRAPPED — Section 6: Testimonials
  sections/strapped-testimonials.liquid
============================================================ {%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --sb-bg:         {{ section.settings.bg_color }};
    --sb-text:       {{ section.settings.text_color }};
    --sb-accent:     {{ section.settings.accent_color }};
    --sb-champagne:  {{ section.settings.muted_color }};
    --sb-mocha:      {{ section.settings.handle_color }};
    --sb-gold:       {{ section.settings.star_color }};
    padding-top:    {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- render 'strapped-fonts' -%}

<style>
  .strapped-testimonials {
    padding: {{ section.settings.section_pad_v }}px {{ section.settings.section_pad_h }}px;
    background: var(--sb-bg);
    color: var(--sb-text);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: {{ section.settings.col_gap }}px;
    align-items: center;
  }

  .strapped-testimonials__tag {
    font-family: {{ section.settings.eyebrow_font }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    font-style: {{ section.settings.eyebrow_style }};
    letter-spacing: {{ section.settings.eyebrow_tracking }};
    text-transform: {{ section.settings.eyebrow_transform }};
    color: {{ section.settings.eyebrow_color }};
    margin-bottom: 1rem;
  }

  .strapped-testimonials__title {
    font-family: {{ section.settings.heading_font }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    font-style: {{ section.settings.heading_style }};
    letter-spacing: {{ section.settings.heading_tracking }};
    text-transform: {{ section.settings.heading_transform }};
    color: {{ section.settings.heading_color }};
    line-height: {{ section.settings.heading_line_height }};
  }

  .strapped-testimonials__title em {
    font-family: {{ section.settings.heading_em_font }};
    font-style: {{ section.settings.heading_em_style }};
    color: var(--sb-accent);
  }

  .strapped-testimonials__body {
    font-family: {{ section.settings.body_font }};
    font-size: {{ section.settings.body_size }}px;
    font-weight: {{ section.settings.body_weight }};
    font-style: {{ section.settings.body_style }};
    letter-spacing: {{ section.settings.body_tracking }};
    text-transform: {{ section.settings.body_transform }};
    color: {{ section.settings.body_color }};
    line-height: {{ section.settings.body_line_height }};
    margin: {{ section.settings.body_margin_top }}px 0 {{ section.settings.body_margin_bottom }}px;
  }

  .strapped-testimonials__btn {
    background: var(--sb-accent);
    color: var(--sb-bg);
    padding: {{ section.settings.btn_pad_v }}px {{ section.settings.btn_pad_h }}px;
    font-family: {{ section.settings.btn_font }};
    font-size: {{ section.settings.btn_size }}px;
    font-weight: {{ section.settings.btn_weight }};
    font-style: {{ section.settings.btn_style }};
    letter-spacing: {{ section.settings.btn_tracking }};
    text-transform: {{ section.settings.btn_transform }};
    color: {{ section.settings.btn_color }};
    border: {{ section.settings.btn_border_w }}px solid {{ section.settings.btn_border_c }};
    border-radius: {{ section.settings.btn_radius }}px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
    text-decoration: none;
    display: inline-block;
    line-height: 1;
  }

  .strapped-testimonials__btn:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .strapped-testimonials__cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .strapped-testimonials__card {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid rgba(255,255,255,0.09);
    padding: {{ section.settings.card_pad_v }}px {{ section.settings.card_pad_h }}px;
    transition: background 0.3s;
  }

  .strapped-testimonials__card:hover {
    background: {{ section.settings.card_hover_bg_color }};
  }

  .strapped-testimonials__quote {
    font-family: {{ section.settings.quote_font }};
    font-size: {{ section.settings.quote_size }}px;
    font-weight: {{ section.settings.quote_weight }};
    font-style: {{ section.settings.quote_style }};
    letter-spacing: {{ section.settings.quote_tracking }};
    text-transform: {{ section.settings.quote_transform }};
    color: {{ section.settings.quote_color }};
    line-height: {{ section.settings.quote_line_height }};
    margin-bottom: 1rem;
  }

  .strapped-testimonials__author {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .strapped-testimonials__avatar {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    background: var(--sb-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sb-font-heading);
    font-size: {{ section.settings.avatar_initial_size }}px;
    color: var(--sb-bg);
    font-weight: 600;
    flex-shrink: 0;
  }

  .strapped-testimonials__name {
    font-family: {{ section.settings.author_name_font }};
    font-size: {{ section.settings.author_name_size }}px;
    font-weight: {{ section.settings.author_name_weight }};
    font-style: {{ section.settings.author_name_style }};
    letter-spacing: {{ section.settings.author_name_tracking }};
    text-transform: {{ section.settings.author_name_transform }};
    color: {{ section.settings.author_name_color }};
  }

  .strapped-testimonials__handle {
    font-family: {{ section.settings.author_handle_font }};
    font-size: {{ section.settings.author_handle_size }}px;
    font-weight: {{ section.settings.author_handle_weight }};
    font-style: {{ section.settings.author_handle_style }};
    letter-spacing: {{ section.settings.author_handle_tracking }};
    text-transform: {{ section.settings.author_handle_transform }};
    color: {{ section.settings.author_handle_color }};
    margin-top: 0.1rem;
  }

  .strapped-testimonials__stars {
    font-size: {{ section.settings.star_size }}px;
    color: var(--sb-gold);
    letter-spacing: 0.1em;
    margin-left: auto;
  }

  @media (max-width: 900px) {
    .strapped-testimonials {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: {{ section.settings.mobile_pad_v }}px {{ section.settings.mobile_pad_h }}px;
    }
  }
</style>

<div class="strapped-testimonials" id="strapped-vibe">
  <div>

    {%- if section.settings.eyebrow != blank -%}
      <div class="strapped-testimonials__tag">
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}

    {%- assign strapped_heading_text = section.settings.heading | newline_to_br -%}

    <h2 class="strapped-testimonials__title">
      {% render 'highlight-brackets',
        text: strapped_heading_text,
        class: 'section-title-highlight'
      %}
    </h2>

    {%- if section.settings.body != blank -%}
      <p class="strapped-testimonials__body">
        {{ section.settings.body }}
      </p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank and section.settings.btn_url != blank -%}
      <a
        href="{{ section.settings.btn_url }}"
        class="strapped-testimonials__btn"
      >
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

  </div>

  <div class="strapped-testimonials__cards">

    {%- for block in section.blocks -%}

      {%- if block.type == 'testimonial' -%}

        <div
          class="strapped-testimonials__card"
          {{ block.shopify_attributes }}
        >

          <p class="strapped-testimonials__quote">
            "{{ block.settings.quote }}"
          </p>

          <div class="strapped-testimonials__author">

            <div class="strapped-testimonials__avatar">
              {{ block.settings.name | slice: 0 | upcase }}
            </div>

            <div>

              <div class="strapped-testimonials__name">
                {{ block.settings.name }}
              </div>

              {%- if block.settings.handle != blank -%}
                <div class="strapped-testimonials__handle">
                  {{ block.settings.handle }}
                </div>
              {%- endif -%}

            </div>

            {%- if block.settings.show_stars -%}
              <div class="strapped-testimonials__stars">
                ★★★★★
              </div>
            {%- endif -%}

          </div>

        </div>

      {%- endif -%}

    {%- endfor -%}

  </div>

</div>

