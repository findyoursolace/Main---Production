{% comment %}
  Section: Watch Band Features Hero
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .wbf-wrapper {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  #shopify-section-{{ section.id }} .wbf-section {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .wbf-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
    margin-bottom: {{ section.settings.header_bottom_spacing }}px;
  }

  #shopify-section-{{ section.id }} .wbf-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.05;
    font-weight: 800;
    margin: 0;
    max-width: 560px;
  }

  #shopify-section-{{ section.id }} .wbf-subheading {
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.5;
    max-width: 460px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .wbf-subheading p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .wbf-card {
    background-color: {{ section.settings.card_background_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_corner_radius }}px;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
  }

  #shopify-section-{{ section.id }} .wbf-feature {
    padding: {{ section.settings.feature_padding }}px;
    border-left: 1px solid {{ section.settings.card_border_color }};
  }

  #shopify-section-{{ section.id }} .wbf-feature:first-child {
    border-left: none;
  }

  #shopify-section-{{ section.id }} .wbf-feature-title {
    color: {{ section.settings.feature_title_color }};
    font-size: {{ section.settings.feature_title_size }}px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }

  #shopify-section-{{ section.id }} .wbf-feature-text {
    color: {{ section.settings.feature_text_color }};
    font-size: {{ section.settings.feature_text_size }}px;
    line-height: 1.55;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .wbf-feature-text p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wbf-header {
      flex-direction: column;
      gap: 20px;
      margin-bottom: {{ section.settings.header_bottom_spacing | times: 0.6 | round }}px;
    }

    #shopify-section-{{ section.id }} .wbf-heading {
      font-size: {{ section.settings.heading_size | times: 0.6 | round }}px;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .wbf-subheading {
      font-size: {{ section.settings.subheading_size | times: 0.9 | round }}px;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .wbf-card {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .wbf-feature {
      border-left: none;
      border-top: 1px solid {{ section.settings.card_border_color }};
    }

    #shopify-section-{{ section.id }} .wbf-feature:first-child {
      border-top: none;
    }
  }
</style>

<div class="wbf-section">
  <div class="wbf-wrapper">

    <div class="wbf-header">

      {%- assign wbf_heading_text = section.settings.heading | newline_to_br -%}

      <h2 class="wbf-heading">
        {% render 'highlight-brackets',
          text: wbf_heading_text,
          class: 'section-title-highlight'
        %}
      </h2>

      <div class="wbf-subheading">
        {{ section.settings.subheading }}
      </div>

    </div>

    {% if section.blocks.size > 0 %}
      <div class="wbf-card">
        {% for block in section.blocks %}
          <div class="wbf-feature" {{ block.shopify_attributes }}>
            <p class="wbf-feature-title">
              {{ block.settings.title }}
            </p>

            <div class="wbf-feature-text">
              {{ block.settings.text }}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Watch Benefits",
  "settings": [
    {
      "type": "header",
      "content": "Heading & Subheading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "One watch.\n[More ways] to wear it."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Make the switch from a band that feels generic and irritating to one that matches how you move, dress, train, and live.</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size (desktop, px)",
      "min": 28,
      "max": 80,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading font size (desktop, px)",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "header_bottom_spacing",
      "label": "Space below header",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "header",
      "content": "Feature Card"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "feature_padding",
      "label": "Feature cell padding",
      "min": 16,
      "max": 64,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "feature_title_size",
      "label": "Feature title font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "feature_text_size",
      "label": "Feature text font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border / divider color",
      "default": "#E5E1DB"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Feature title color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "Feature text color",
      "default": "#595550"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width (px)",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this feature.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Watch Benefits",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Comfort that adapts",
            "text": "<p>Soft woven, adjustable, lightweight, and breathable options designed around all-day wear.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Style beyond silicone",
            "text": "<p>Choose colorful braids, polished metals, leather, wood, performance nylon, and everyday finishes.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Clean-material options",
            "text": "<p>Shop the brand's PFAS-free watch-band collection and check each product page for material details.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Built to stay in rotation",
            "text": "<p>Featured bands include a lifetime warranty, with care and fit details listed on each product page.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}