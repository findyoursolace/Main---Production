{% liquid
  assign max_items = section.settings.max_products
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="product-list-variant-grid"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  id="featured"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% assign rendered_items = 0 %}

    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by 50 %}
        {% for product in section.settings.collection.products %}
          {% if rendered_items >= max_items %}
            {% break %}
          {% endif %}

          {%- if product.metafields.maltertech.hidden -%}
            {% continue %}
          {%- endif -%}

          {% assign rule_namespace = '' %}
          {% assign rule_key = '' %}
          {% assign rule = '' %}

          {% if section.settings.collection.metafields.maltertech.show_variants %}
            {% assign rule_namespace = 'maltertech' %}
            {% assign rule_key = 'show_variant_2' %}
            {% assign rule = 'variant_rule' %}

          {% elsif section.settings.collection.metafields.custom.show_variants_wwp %}
            {% assign rule_namespace = 'custom' %}
            {% assign rule_key = 'show_variants_wwp_2' %}
            {% assign rule = 'variant_rule' %}

                  {% elsif section.settings.collection.metafields.custom.show_variants_mbc %}
            {% assign rule_namespace = 'custom' %}
            {% assign rule_key = 'show_variants_mbc' %}
            {% assign rule = 'variant_rule' %}

          {% elsif section.settings.collection.metafields.custom.show_preorder_variants %}
            {% assign rule_namespace = 'custom' %}
            {% assign rule_key = 'show_preorder_variants' %}
            {% assign rule = 'variant_rule' %}

          {% elsif section.settings.collection.metafields.custom.show_variants_non_restocking %}
            {% assign rule_namespace = 'custom' %}
            {% assign rule_key = 'show_variants_nr' %}
            {% assign rule = 'variant_rule' %}
          {% endif %}

          {% if rule == 'variant_rule' %}
            {% assign colors = '' %}

            {% for variant in product.variants %}
              {% if rendered_items >= max_items %}
                {% break %}
              {% endif %}

              {%- if variant.metafields.maltertech.hidden -%}
                {% continue %}
              {%- endif -%}

              {% assign v_mf = variant.metafields[rule_namespace][rule_key] %}

              {% if v_mf and v_mf.value == false %}
                {% continue %}
              {% endif %}

              {% unless v_mf %}
                {% continue %}
              {% endunless %}

              {% assign color = variant.options[0] | default: '' %}
              {% assign color_token = color | append: '___' %}

              {% if color == blank %}
                {% if colors contains '___no_color___' %}
                  {% continue %}
                {% endif %}
                {% assign colors = colors | append: '___no_color___,' %}
              {% else %}
                {% if colors contains color_token %}
                  {% continue %}
                {% endif %}
                {% assign colors = colors | append: color_token | append: ',' %}
              {% endif %}

              {% assign variant_media = variant.featured_media | default: variant.featured_image %}
              {% assign variant_image_url = '' %}

              {% if variant_media != blank %}
                {% if variant_media.preview_image %}
                  {% assign variant_image_url = variant_media.preview_image | image_url: width: 900 %}
                {% else %}
                  {% assign variant_image_url = variant_media | image_url: width: 900 %}
                {% endif %}
              {% endif %}

              <div
                class="resource-list__item"
                data-product-id="{{ product.id }}"
                data-variant-id="{{ variant.id }}"
                data-product-handle="{{ product.handle | escape }}"
                data-variant-url="/products/{{ product.handle }}?variant={{ variant.id }}"
                data-variant-image="{{ variant_image_url }}"
                data-variant-title="{{ variant.option1 | escape }}"
              >
                {% # theme-check-disable UniqueStaticBlockId %}
                  {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
                {% # theme-check-enable UniqueStaticBlockId %}
              </div>

              {% assign rendered_items = rendered_items | plus: 1 %}

              {% if rendered_items < max_items %}
                <!--@list/split-->
              {% endif %}
            {% endfor %}

          {% else %}
            <div class="resource-list__item">
              {% # theme-check-disable UniqueStaticBlockId %}
                {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
              {% # theme-check-enable UniqueStaticBlockId %}
            </div>

            {% assign rendered_items = rendered_items | plus: 1 %}

            {% if rendered_items < max_items %}
              <!--@list/split-->
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div class="resource-list__item">
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

<style>
  .variant-title {
    display: inline;
  }
</style>

{% unless request.design_mode %}
  <script>
    (() => {
      const getProductHandleFromUrl = (urlValue) => {
        if (!urlValue) return '';

        try {
          const url = new URL(urlValue, window.location.origin);
          const pathParts = url.pathname.split('/').filter(Boolean);

          const productsIndex = pathParts.indexOf('products');
          if (productsIndex !== -1 && pathParts[productsIndex + 1]) {
            return pathParts[productsIndex + 1];
          }

          return pathParts[pathParts.length - 1] || '';
        } catch (e) {
          const cleanUrl = String(urlValue).split('?')[0].split('#')[0];
          const pathParts = cleanUrl.split('/').filter(Boolean);

          const productsIndex = pathParts.indexOf('products');
          if (productsIndex !== -1 && pathParts[productsIndex + 1]) {
            return pathParts[productsIndex + 1];
          }

          return pathParts[pathParts.length - 1] || '';
        }
      };

      const isSameProductLink = (href, productUrl, productHandle) => {
        if (!href) return false;

        const expectedHandle = productHandle || getProductHandleFromUrl(productUrl);
        const hrefHandle = getProductHandleFromUrl(href);

        if (expectedHandle && hrefHandle && expectedHandle === hrefHandle) {
          return true;
        }

        try {
          const u = new URL(href, window.location.origin);
          const p = new URL(productUrl, window.location.origin);
          return u.pathname === p.pathname;
        } catch (e) {
          return href.indexOf(productUrl) !== -1;
        }
      };

      const applyVariantCard = (card) => {
        if (!card?.dataset?.variantUrl || card.dataset.variantPatched === '1') return;
        card.dataset.variantPatched = '1';

        const variantUrl = card.dataset.variantUrl;
        const productUrl = variantUrl.split('?')[0];
        const productHandle = card.dataset.productHandle || getProductHandleFromUrl(productUrl);
        const imgUrl = card.dataset.variantImage;
        const variantTitle = card.dataset.variantTitle;

        if (variantTitle && variantTitle !== 'Default Title') {
          const productLinks = Array.from(card.querySelectorAll('a[href]'));

          const matchingTextLinks = productLinks.filter((a) => {
            const href = a.getAttribute('href');

            return (
              href &&
              isSameProductLink(href, productUrl, productHandle) &&
              !a.classList.contains('variant-card-cta') &&
              !a.closest('.variant-card-cta') &&
              !a.querySelector('img') &&
              !a.querySelector('picture') &&
              !a.querySelector('.variant-title') &&
              a.textContent.trim().length > 0
            );
          });

          const preferredTitleLink =
            card.querySelector('[data-testid="product-title"] a[href]') ||
            card.querySelector('.product-title a[href]') ||
            card.querySelector('.product-card__title a[href]') ||
            matchingTextLinks[matchingTextLinks.length - 1];

          if (
            preferredTitleLink &&
            !preferredTitleLink.classList.contains('variant-card-cta') &&
            !preferredTitleLink.closest('.variant-card-cta') &&
            isSameProductLink(preferredTitleLink.getAttribute('href'), productUrl, productHandle) &&
            !preferredTitleLink.querySelector('.variant-title')
          ) {
            const span = document.createElement('span');
            span.className = 'variant-title';
            span.textContent = ` - ${variantTitle}`;
            preferredTitleLink.appendChild(span);
          }
        }

        card.querySelectorAll('a[href]').forEach((a) => {
          const href = a.getAttribute('href');

          if (href && isSameProductLink(href, productUrl, productHandle)) {
            a.setAttribute('href', variantUrl);
          }
        });

        if (imgUrl) {
          card.querySelectorAll('picture source[srcset], picture source[data-srcset]').forEach((s) => {
            if (s.hasAttribute('srcset')) s.setAttribute('srcset', imgUrl);
            if (s.hasAttribute('data-srcset')) s.setAttribute('data-srcset', imgUrl);
          });

          const img =
            card.querySelector('img[src], img[data-src], img[data-srcset], img[srcset]') ||
            card.querySelector('img');

          if (img) {
            if (img.hasAttribute('src')) img.setAttribute('src', imgUrl);
            if (img.hasAttribute('data-src')) img.setAttribute('data-src', imgUrl);
            if (img.hasAttribute('srcset')) img.setAttribute('srcset', imgUrl);
            if (img.hasAttribute('data-srcset')) img.setAttribute('data-srcset', imgUrl);
            if (img.hasAttribute('data-master')) img.setAttribute('data-master', imgUrl);
          }
        }
      };

      const applyAll = (root) => {
        root.querySelectorAll?.('.resource-list__item[data-variant-url]').forEach(applyVariantCard);
        if (root.matches?.('.resource-list__item[data-variant-url]')) applyVariantCard(root);
      };

      applyAll(document);

      const obs = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => {
            if (node.nodeType === 1) applyAll(node);
          });
        });
      });

      obs.observe(document.body, { childList: true, subtree: true });
    })();
  </script>
{% endunless %}

{% schema %}
{
  "name": "collection: Variant grid",
  "class": "ui-test-product-list product-list-variant-grid",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "_divider" },
    { "type": "_product-list-content" },
    { "type": "_product-card" }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
