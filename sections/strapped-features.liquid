{%- comment -%} ============================================================
  STRAPPED — Section 5: Feature Strip
  sections/strapped-features.liquid
============================================================ {%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --sb-cream:     {{ section.settings.bg_color }};
    --sb-champagne: {{ section.settings.border_color }};
    padding-top:    {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- render 'strapped-fonts' -%}

<style>
  .strapped-features {
    background: var(--sb-cream);
    border-top: 1px solid var(--sb-champagne);
    border-bottom: 1px solid var(--sb-champagne);
  }
  .strapped-features__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, 1fr);
  }
  .strapped-features__item {
    padding: {{ section.settings.item_pad_v }}px {{ section.settings.item_pad_h }}px;
    border-right: 1px solid var(--sb-champagne);
  }
  .strapped-features__item:last-child { border-right: none; }
  .strapped-features__icon { font-size: {{ section.settings.icon_size }}px; margin-bottom: {{ section.settings.icon_margin }}px; display: block; }
  .strapped-features__title {
        font-family: {{ section.settings.title_font }};
    font-size:   {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    font-style:  {{ section.settings.title_style }};
    letter-spacing: {{ section.settings.title_tracking }};
    text-transform: {{ section.settings.title_transform }};
    color: {{ section.settings.title_color }};
    margin-bottom: 0.5rem;
  }
  .strapped-features__desc {
        font-family: {{ section.settings.desc_font }};
    font-size:   {{ section.settings.desc_size }}px;
    font-weight: {{ section.settings.desc_weight }};
    font-style:  {{ section.settings.desc_style }};
    letter-spacing: {{ section.settings.desc_tracking }};
    text-transform: {{ section.settings.desc_transform }};
    color: {{ section.settings.desc_color }};
    line-height: {{ section.settings.desc_line_height }};
  }
  @media (max-width: 900px) {
    .strapped-features__grid { grid-template-columns: 1fr; }
    .strapped-features__item { border-right: none; border-bottom: 1px solid var(--sb-champagne); }
    .strapped-features__item:last-child { border-bottom: none; }
  }
</style>

<div class="strapped-features">
  <div class="strapped-features__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'feature' -%}
        <div class="strapped-features__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="strapped-features__icon">{{ block.settings.icon }}</span>
          {%- endif -%}
          <div class="strapped-features__title">{{ block.settings.title }}</div>
          {%- if block.settings.description != blank -%}
            <p class="strapped-features__desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

