<script>
(function() {
  var SID = {{ section_id | json }};
  var SHOW_PRICES = {{ show_prices | json }};
  var DEAL_5_PRICE = {{ section.settings.deal_5_flat_price | json }};
  var CTA_READY_LABEL = {{ section.settings.cta_ready_label | json }};
  var CTA_PROGRESS_LABEL = {{ section.settings.cta_progress_label | json }};
  var CTA_INITIAL_LABEL = {{ section.settings.cta_initial_label | json }};

  var SIZE_ICON_MAP = {};
  {%- for block in section.blocks -%}
    {%- if block.type == 'size_icon' and block.settings.size_name != blank and block.settings.size_image != blank -%}
    SIZE_ICON_MAP[{{ block.settings.size_name | json }}] = {{ block.settings.size_image | img_url: '200x' | json }};
    {%- endif -%}
  {%- endfor -%}

  var RAW_PRODUCTS = [
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' and block.settings.product != blank -%}
      {%- assign prod = block.settings.product -%}
      {
        "id": {{ prod.id | json }},
        "title": {{ prod.title | json }},
        "showOnAllSizes": {{ block.settings.show_on_all_sizes | json }},
        "watchCompatibility": {{ block.settings.watch_compatibility | json }},
        "benefits": {{ block.settings.benefits | newline_to_br | split: "<br />" | json }},

        "variants": [
          {%- for variant in prod.variants -%}
          {
            "id": {{ variant.id | json }},
            "option1": {{ variant.option1 | json }},
            "option2": {{ variant.option2 | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "available": {{ variant.available | json }},
            "hidden": {{ variant.metafields.maltertech.hidden | json }},
            "bandStyle": {{ variant.metafields.custom.band_style | json }},
            "patternOptions": {{ variant.metafields.custom.pattern_options | json }},
            "featured_image": {{ variant.featured_image.src | default: prod.featured_image.src | img_url: '400x400', crop: 'center' | json }}
          }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  ];

  window.__BB = window.__BB || {};
  window.__BB[SID] = {
    rawProducts: RAW_PRODUCTS,
    showPrices: SHOW_PRICES,
    deal5Price: DEAL_5_PRICE,
    ctaReadyLabel: CTA_READY_LABEL,
    ctaProgressLabel: CTA_PROGRESS_LABEL,
    ctaInitialLabel: CTA_INITIAL_LABEL,
    sizeIconMap: SIZE_ICON_MAP,
    checkoutMode: {{ section.settings.checkout_mode | json }},
    showCardBenefits: {{ section.settings.show_card_benefits | json }},
    showFilters: {{ section.settings.show_filters | json }},
    defaultDeal: {{ section.settings.default_deal | json }}
  };
})();
</script>

<script>
(function() {
  var cfg = window.__BB[{{ section_id | json }}];
  if (!cfg) return;

  var SID = {{ section_id | json }};
  var $ = function(id) { return document.getElementById(SID + '-' + id); };
  var root = document.getElementById(SID);

  var cards = [];
  cfg.rawProducts.forEach(function(prod) {
    var seenColors = {};
    prod.variants.forEach(function(v) {
      if (v.hidden === true) return;
      var color = v.option1 || 'Default';
      if (!seenColors[color]) {
        seenColors[color] = {
          productId: prod.id,
          productTitle: prod.title,
          color: color,
          showOnAllSizes: prod.showOnAllSizes || false,
          watchCompatibility: prod.watchCompatibility || 'both',
          benefits: prod.benefits || [],
          material: null,
          colorFamily: null,
          variantsBySize: {},
          lowestPrice: Infinity
        };
        cards.push(seenColors[color]);
      }
      seenColors[color].variantsBySize[v.option2 || 'One Size'] = v;
      if (!seenColors[color].material && v.bandStyle) {
        seenColors[color].material = Array.isArray(v.bandStyle) ? v.bandStyle[0] : v.bandStyle;
      }
      if (!seenColors[color].colorFamily && v.patternOptions) {
        seenColors[color].colorFamily = Array.isArray(v.patternOptions) ? v.patternOptions[0] : v.patternOptions;
      }
      var p = v.price / 100;
      if (p < seenColors[color].lowestPrice) seenColors[color].lowestPrice = p;
    });
  });

  var state = { activeDeal: null, dealSlots: 0, selectedWatch: 'apple', selectedSize: null, qty: {}, filterMaterial: null, filterColor: null };
  cards.forEach(function(c) { state.qty[c.productId + '_' + c.color] = 0; });

  var fallbackIcons = [
    '<svg width="22" height="10" viewBox="0 0 22 10" fill="none"><rect x="1" y="1" width="20" height="8" rx="3" stroke-width="1.5"/></svg>',
    '<svg width="30" height="13" viewBox="0 0 30 13" fill="none"><rect x="1" y="1" width="28" height="11" rx="3" stroke-width="1.5"/></svg>',
    '<svg width="38" height="16" viewBox="0 0 38 16" fill="none"><rect x="1" y="1" width="36" height="14" rx="3" stroke-width="1.5"/></svg>',
    '<svg width="46" height="19" viewBox="0 0 46 19" fill="none"><rect x="1" y="1" width="44" height="17" rx="3" stroke-width="1.5"/></svg>'
  ];

  function renderSizeButtons(watchType) {
    var sizeRow = document.getElementById(SID + '-sizes');
    if (!sizeRow) return;
    var sizesForWatch = []; var seen = {};
    cards.forEach(function(c) {
      if (c.showOnAllSizes) return;
      var wc = c.watchCompatibility || 'both';
      if (wc !== 'both' && wc !== watchType) return;
      Object.keys(c.variantsBySize).forEach(function(sz) { if (!seen[sz]) { seen[sz] = true; sizesForWatch.push(sz); } });
    });
    if (sizesForWatch.length === 0) { sizeRow.innerHTML = ''; return; }
    if (!seen[state.selectedSize]) state.selectedSize = sizesForWatch[0];
    var html = '';
    sizesForWatch.forEach(function(sz, i) {
      var isActive = sz === state.selectedSize;
      var customImg = cfg.sizeIconMap && cfg.sizeIconMap[sz];
      var iconHtml = customImg
        ? '<img src="' + customImg + '" alt="' + sz + '" style="display:block;width:100%;height:auto;object-fit:contain;object-position:center;max-width:none;aspect-ratio:unset;">'
        : (fallbackIcons[Math.min(i, fallbackIcons.length - 1)]);
      html += '<button class="bb-sz-btn' + (isActive ? ' is-on' : '') + '" data-size="' + sz + '">'
        + '<div class="bb-sz-icon">' + iconHtml + '</div>'
        + '<span class="bb-sz-name">' + sz + '</span></button>';
    });
    sizeRow.innerHTML = html;
    sizeRow.querySelectorAll('.bb-sz-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.selectedSize = btn.getAttribute('data-size');
        sizeRow.querySelectorAll('.bb-sz-btn').forEach(function(b) { b.classList.toggle('is-on', b === btn); });
        if (state.activeDeal) { if (cfg.showFilters) renderFilters(); renderGrid(); }
        renderCheckout();
      });
    });
  }

  renderSizeButtons(state.selectedWatch);

  var sizeGuideBtn = document.getElementById(SID + '-size-guide-btn');
  var modal = document.getElementById(SID + '-modal');
  var modalClose = document.getElementById(SID + '-modal-close');
  var modalApple = document.getElementById(SID + '-modal-apple');
  var modalUniversal = document.getElementById(SID + '-modal-universal');

  function openSizeGuide() {
    if (!modal) return;
    if (modalApple) modalApple.style.display = state.selectedWatch === 'apple' ? 'block' : 'none';
    if (modalUniversal) modalUniversal.style.display = state.selectedWatch === 'universal' ? 'block' : 'none';
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
  function closeSizeGuide() {
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }
  if (sizeGuideBtn) sizeGuideBtn.addEventListener('click', openSizeGuide);
  if (modalClose) modalClose.addEventListener('click', closeSizeGuide);
  if (modal) modal.addEventListener('click', function(e) { if (e.target === modal) closeSizeGuide(); });

  function getCardKey(c) { return c.productId + '_' + c.color; }
  function getTotalQty() { return Object.values(state.qty).reduce(function(a,b){return a+b;},0); }

  function getVariantForCard(c) {
    if (c.showOnAllSizes) { var k = Object.keys(c.variantsBySize); return c.variantsBySize[k[0]]; }
    var v = c.variantsBySize[state.selectedSize];
    if (!v) { var k = Object.keys(c.variantsBySize); v = c.variantsBySize[k[0]]; }
    return v;
  }

  function getPriceForCard(c) { var v = getVariantForCard(c); return v ? v.price/100 : c.lowestPrice; }

  function getBasketTotal() {
    var t = 0;
    cards.forEach(function(c) { var q = state.qty[getCardKey(c)]; if (q > 0) t += getPriceForCard(c) * q; });
    return t;
  }

  function getCheapestSelected() {
    var ch = null;
    cards.forEach(function(c) {
      if (state.qty[getCardKey(c)] > 0 && (!ch || getPriceForCard(c) < getPriceForCard(ch))) ch = c;
    });
    return ch;
  }

  function fmtPrice(n) { return '$' + n.toFixed(2); }


  function renderFilters() {
    var container = document.getElementById(SID + '-filters');
    if (!container) return;
    var materials = {}, colors = {};
    cards.forEach(function(c) {
      var wc = c.watchCompatibility || 'both';
      if (wc !== 'both' && wc !== state.selectedWatch) return;
      // For material options: only show materials available under current color filter
      if (!state.filterColor || c.colorFamily === state.filterColor) {
        if (c.material) materials[c.material] = true;
      }
      // For color options: only show colors available under current material filter
      if (!state.filterMaterial || c.material === state.filterMaterial) {
        if (c.colorFamily) colors[c.colorFamily] = true;
      }
    });
    // If current selection is no longer valid, auto-clear it
    if (state.filterMaterial && !materials[state.filterMaterial]) state.filterMaterial = null;
    if (state.filterColor && !colors[state.filterColor]) state.filterColor = null;
    var matKeys = Object.keys(materials).sort();
    var colKeys = Object.keys(colors).sort();
    var html = '';
    if (matKeys.length > 1) {
      html += '<div class="bb-filter-wrap">'
        + '<select class="bb-filter-select' + (state.filterMaterial ? ' is-active' : '') + '" data-filter-type="material">'
        + '<option value="">{{ section.settings.filter_material_label }}</option>';
      matKeys.forEach(function(m) {
        html += '<option value="' + m + '"' + (state.filterMaterial === m ? ' selected' : '') + '>' + m + '</option>';
      });
      html += '</select>'
        + '<button class="bb-filter-clear' + (state.filterMaterial ? ' is-visible' : '') + '" data-clear-type="material" aria-label="Clear filter">'
        + '<svg viewBox="0 0 8 8" fill="none"><path d="M1 1l6 6M7 1L1 7" stroke-width="1.5" stroke-linecap="round"/></svg>'
        + '</button></div>';
    }
    if (colKeys.length > 1) {
      html += '<div class="bb-filter-wrap">'
        + '<select class="bb-filter-select' + (state.filterColor ? ' is-active' : '') + '" data-filter-type="color">'
        + '<option value="">{{ section.settings.filter_color_label }}</option>';
      colKeys.forEach(function(c) {
        html += '<option value="' + c + '"' + (state.filterColor === c ? ' selected' : '') + '>' + c + '</option>';
      });
      html += '</select>'
        + '<button class="bb-filter-clear' + (state.filterColor ? ' is-visible' : '') + '" data-clear-type="color" aria-label="Clear filter">'
        + '<svg viewBox="0 0 8 8" fill="none"><path d="M1 1l6 6M7 1L1 7" stroke-width="1.5" stroke-linecap="round"/></svg>'
        + '</button></div>';
    }
    container.innerHTML = html;
    container.querySelectorAll('.bb-filter-select').forEach(function(sel) {
      sel.addEventListener('change', function() {
        var type = sel.getAttribute('data-filter-type');
        var val = sel.value;
        if (type === 'material') { state.filterMaterial = val || null; }
        else { state.filterColor = val || null; }
        renderFilters();
        renderGrid();
      });
    });
    container.querySelectorAll('.bb-filter-clear').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var type = btn.getAttribute('data-clear-type');
        if (type === 'material') { state.filterMaterial = null; }
        else { state.filterColor = null; }
        renderFilters();
        renderGrid();
      });
    });
  }

  function renderGrid() {
    var grid = $('grid'); var total = getTotalQty(); var isFreeNext = state.activeDeal===3&&total===2; var html='';
    cards.forEach(function(c) {
      if (!c.showOnAllSizes && state.selectedSize && !c.variantsBySize[state.selectedSize]) return;
      var wc = c.watchCompatibility || 'both';
      if (wc !== 'both' && wc !== state.selectedWatch) return;
      var variant = getVariantForCard(c);
      if (!variant || !variant.available) return;
      if (state.filterMaterial && c.material !== state.filterMaterial) return;
      if (state.filterColor && c.colorFamily !== state.filterColor) return;
      var key = getCardKey(c); var qty = state.qty[key]; var sel = qty>0;
      var atMax = total>=state.dealSlots&&qty===0;
      var price = variant.price/100;
      var compareAt = variant.compare_at_price?variant.compare_at_price/100:null;
      var img = variant.featured_image?variant.featured_image:null;
      var cardCls = 'bb-bc'+(sel?' is-sel':'')+(atMax?' is-maxed':'');
      var priceHtml='';
      if (cfg.showPrices) {
        if (isFreeNext&&!sel) priceHtml='<span class="was">'+fmtPrice(price)+'</span> <span class="free-label">FREE</span>';
        else if (compareAt&&compareAt>price) priceHtml='<span class="was">'+fmtPrice(compareAt)+'</span> '+fmtPrice(price);
        else priceHtml=fmtPrice(price);
      }
      var actionHtml='';
      if (sel) {
        actionHtml='<div class="bb-qc"><button class="bb-qb" data-action="dec" data-key="'+key+'">&#8722;</button><span class="bb-qn">'+qty+'</span><button class="bb-qb" data-action="inc" data-key="'+key+'"'+(total<state.dealSlots?'':' disabled')+'>+</button></div>';
      } else if (state.activeDeal) {
        actionHtml='<button class="bb-add-btn" data-action="add" data-key="'+key+'">'+(isFreeNext?'Add free':'Add')+'</button>';
      }
      html+='<div class="'+cardCls+'" data-key="'+key+'">'
        +'<div class="bb-bc-img">'+(img?'<img src="'+img+'" alt="'+c.productTitle+' '+c.color+'" loading="lazy">':'<div class="bb-no-img"></div>')
        +'<button class="bb-zoom-btn" data-zoom-key="'+key+'" aria-label="Quick view"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="6" cy="6" r="4.5"/><line x1="9.5" y1="9.5" x2="13" y2="13"/></svg></button>'
        +'<div class="bb-sel-check"><svg width="9" height="8" viewBox="0 0 9 8" fill="none"><path d="M1.5 4L3 5.5L7 1.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>'
        +(isFreeNext&&!sel?'<div class="bb-free-tag" style="display:block">FREE</div>':'')
        +'</div><div class="bb-bc-body">'
        +'<div class="bb-bc-name">'+c.productTitle+'</div>'
        +'<div class="bb-bc-type"><span class="bb-bc-color-swatch" style="background:'+colorNameToHex(c.color)+'"></span>'+c.color+'</div>'
        +(cfg.showCardBenefits&&c.benefits&&c.benefits.length?'<div class="bb-bc-benefits">'+c.benefits.filter(Boolean).map(function(b){return '<div class="bb-bc-benefit"><div class="bb-bc-benefit-dot"></div>'+b.trim()+'</div>';}).join('')+'</div>':'')
        +'<div class="bb-bc-foot">'+(cfg.showPrices?'<div class="bb-bc-price">'+priceHtml+'</div>':'<div></div>')+actionHtml+'</div>'
        +'</div></div>';
    });
    grid.innerHTML = html;
    grid.querySelectorAll('[data-action]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        changeQty(btn.getAttribute('data-key'), btn.getAttribute('data-action')==='dec'?-1:1);
      });
    });
    grid.querySelectorAll('.bb-zoom-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        openProductView(btn.getAttribute('data-zoom-key'));
      });
    });
  }

  function renderCheckout() {
    var total = getTotalQty();
    var cbDeal=$('cbdeal'),cbPrice=$('cbprice'),cbWas=$('cbwas'),cbPerk=$('cbperk');
    var cta=$('cta'),progLeft=$('progleft'),progRight=$('progright'),progFill=$('progfill');
    var progWrap=$('progwrap');
    var stepNums=root.querySelectorAll('.bb-step-num'),stepLabels=root.querySelectorAll('.bb-step-label');
    if (!state.activeDeal) {
      cbDeal.textContent=''; cbPrice.textContent=''; cbWas.innerHTML=''; cbPerk.innerHTML='';
      cta.disabled=true; cta.textContent=cfg.ctaInitialLabel||'Choose your deal above';
      if (progWrap) progWrap.classList.add('is-hidden');
      return;
    }
    if (progWrap) progWrap.classList.remove('is-hidden');
    var base=getBasketTotal(),display=base,wasTxt='',saveTxt='',perkHtml='';
    var names={1:'1 band',3:'Buy 2, get 1 free',5:'5 for $'+cfg.deal5Price+' bundle'};
    if (state.activeDeal===3&&total===3&&cfg.showPrices) {
      var ch=getCheapestSelected(); if(ch){var fp=getPriceForCard(ch);display=base-fp;wasTxt=fmtPrice(base);saveTxt='\u2212'+fmtPrice(fp);perkHtml='<span class="bb-cb-perk">1 band free</span>';}
    } else if (state.activeDeal===5&&total===5) {
      display=cfg.deal5Price;wasTxt=fmtPrice(base);saveTxt='\u2212'+fmtPrice(base-cfg.deal5Price);perkHtml='<span class="bb-cb-perk">Free shipping</span>';
    }
    cbDeal.textContent=names[state.activeDeal]||'';
    cbPrice.textContent=total>0&&cfg.showPrices?fmtPrice(display):'\u2014';
    cbWas.innerHTML=wasTxt?'<span class="bb-cb-was">'+wasTxt+'</span><span class="bb-cb-save"> '+saveTxt+'</span>':'';
    cbPerk.innerHTML=perkHtml;
    var pct=Math.min(100,Math.round(total/state.dealSlots*100));
    progFill.style.width=pct+'%'; progRight.textContent=total+'/'+state.dealSlots;
    if (total<state.dealSlots) {
      var rem=state.dealSlots-total;
      progLeft.textContent='Add '+rem+' more band'+(rem===1?'':'s');
      cta.disabled=true; cta.textContent=cfg.ctaProgressLabel.replace('{n}',rem).replace('{s}',rem===1?'':'s');
    } else {
      progLeft.textContent='Bundle ready'; cta.disabled=false; cta.textContent=cfg.ctaReadyLabel||'Add bundle to cart \u2192';
    }
    var ss=total>=state.dealSlots?3:state.activeDeal?2:1;
    stepNums.forEach(function(el){var n=parseInt(el.getAttribute('data-step'));el.classList.remove('is-active','is-done');if(n<ss)el.classList.add('is-done');else if(n===ss)el.classList.add('is-active');});
    stepLabels.forEach(function(el,i){el.classList.toggle('is-active',i+1===ss);});
  }

  function changeQty(key, delta) {
    var total = getTotalQty();
    if (delta>0&&total>=state.dealSlots) return;
    state.qty[key]=Math.max(0,(state.qty[key]||0)+delta);
    renderGrid(); renderCheckout();
  }

  root.querySelectorAll('.bb-deal-row').forEach(function(row) {
    row.addEventListener('click', function() {
      var deal=parseInt(row.getAttribute('data-deal'));
      state.activeDeal=deal; state.dealSlots=deal;
      Object.keys(state.qty).forEach(function(k){state.qty[k]=0;});
      root.querySelectorAll('.bb-deal-row').forEach(function(r){r.classList.remove('is-selected');});
      row.classList.add('is-selected');
      var step2=document.getElementById(SID+'-step2'); step2.classList.add('is-visible');
      var sub=document.getElementById(SID+'-bandssub'); if(sub) sub.textContent=deal===1?'Select 1':'Select any '+deal;
      if (cfg.showFilters) renderFilters(); renderGrid(); renderCheckout();
      setTimeout(function(){step2.scrollIntoView({behavior:'smooth',block:'start'});},50);
    });
  });

  root.querySelectorAll('.bb-watch-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      state.selectedWatch = btn.getAttribute('data-watch');
      root.querySelectorAll('.bb-watch-btn').forEach(function(b) { b.classList.toggle('is-on', b.getAttribute('data-watch') === state.selectedWatch); });
      cards.forEach(function(c) { var wc = c.watchCompatibility || 'both'; if (wc !== 'both' && wc !== state.selectedWatch) state.qty[getCardKey(c)] = 0; });
      renderSizeButtons(state.selectedWatch);
      if (state.activeDeal) { if (cfg.showFilters) renderFilters(); renderGrid(); }
      renderCheckout();
    });
  });

  document.getElementById(SID+'-cta').addEventListener('click', function() {
    if (this.disabled) return;
    var items=[];
    cards.forEach(function(c){var q=state.qty[getCardKey(c)];if(q>0){var v=getVariantForCard(c);if(v)items.push({id:v.id,quantity:q});}});
    if (!items.length) return;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
    .then(function(r){return r.json();})
    .then(function(){
      if (cfg.checkoutMode === 'direct') {
        window.location.href = '/checkout';
      } else {
        window.location.href = '/cart';
      }
    })
    .catch(function(err){console.error('Bundle builder cart error:',err);});
  });

  // ── Product quick view modal ──
  function openProductView(key) {
    var card = cards.find(function(c) { return getCardKey(c) === key; });
    if (!card) return;
    var v = getVariantForCard(card);
    var img = v && v.featured_image ? v.featured_image : null;
    var pvOverlay = document.getElementById(SID + '-pv-modal');
    var pvImg = document.getElementById(SID + '-pv-img');
    var pvTitle = document.getElementById(SID + '-pv-title');
    var pvColor = document.getElementById(SID + '-pv-color');
    var pvSwatch = document.getElementById(SID + '-pv-swatch');
    var pvBenefits = document.getElementById(SID + '-pv-benefits');
    if (!pvOverlay) return;
    if (pvImg) { pvImg.src = img ? img.replace('_400x400', '_800x800') : ''; pvImg.style.display = img ? 'block' : 'none'; }
    if (pvTitle) pvTitle.textContent = card.productTitle;
    if (pvColor) pvColor.querySelector('.bb-pv-color-label').textContent = card.color;
    if (pvSwatch) pvSwatch.style.background = colorNameToHex(card.color);
    if (pvBenefits) {
      var benefits = card.benefits ? card.benefits.filter(Boolean) : [];
      if (benefits.length) {
        pvBenefits.innerHTML = benefits.map(function(b) {
          return '<div class="bb-pv-benefit"><div class="bb-pv-benefit-dot"></div>' + b.trim() + '</div>';
        }).join('');
      } else {
        pvBenefits.innerHTML = '';
      }
    }
    pvOverlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeProductView() {
    var pvOverlay = document.getElementById(SID + '-pv-modal');
    if (pvOverlay) pvOverlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  var pvOverlay = document.getElementById(SID + '-pv-modal');
  var pvClose = document.getElementById(SID + '-pv-close');
  if (pvClose) pvClose.addEventListener('click', closeProductView);
  if (pvOverlay) pvOverlay.addEventListener('click', function(e) { if (e.target === pvOverlay) closeProductView(); });

  function colorNameToHex(name) {
    var map={'black':'#1a1a1a','white':'#f5f5f5','silver':'#c0c0c0','gold':'#c8a84b','rose gold':'#c9897c',
      'midnight':'#1c1c3a','starlight':'#e8e0d5','blue':'#3a7bd5','red':'#d53a3a','green':'#3a8c5c',
      'yellow':'#d4a017','orange':'#d4661a','purple':'#7a3ad4','pink':'#d43a9e','gray':'#888','grey':'#888',
      'tan':'#b8956a','brown':'#7a5230','teal':'#2a8c8c','navy':'#1a2d5a','cream':'#f5eedc','olive':'#6b7a2a',
      'coral':'#d45a3a','slate':'#5a6a7a','graphite':'#4a4a4a','sand':'#c4a87a','mint':'#6abf8c'};
    var l=(name||'').toLowerCase();
    for(var k in map){if(l.indexOf(k)!==-1)return map[k];}
    return '#888';
  }

  // Pre-select default deal on page load
  if (cfg.defaultDeal) {
    var defaultRow = root.querySelector('.bb-deal-row[data-deal="' + cfg.defaultDeal + '"]');
    if (defaultRow) defaultRow.click();
  } else {
    renderCheckout();
  }
})();
</script>

{% schema %}
{
  "name": "Bundle Builder",
  "tag": "section",
  "class": "bundle-builder-section",
  "settings": [
    { "type": "header", "content": "Layout & spacing" },
    { "type": "range", "id": "max_width", "label": "Max content width (px)", "min": 600, "max": 1400, "step": 20, "default": 860 },
    { "type": "range", "id": "section_padding_x", "label": "Horizontal padding (px)", "min": 0, "max": 80, "step": 4, "default": 20 },
    { "type": "range", "id": "section_padding_y", "label": "Vertical section padding (px)", "min": 8, "max": 80, "step": 4, "default": 24 },
    { "type": "range", "id": "hero_padding_y", "label": "Hero vertical padding (px)", "min": 8, "max": 80, "step": 4, "default": 28 },
    { "type": "range", "id": "border_radius", "label": "Border radius (px)", "min": 0, "max": 32, "step": 2, "default": 12 },
    { "type": "range", "id": "card_gap", "label": "Card grid gap (px)", "min": 4, "max": 32, "step": 2, "default": 8 },
    { "type": "range", "id": "card_min_width", "label": "Min product card width — desktop (px)", "min": 100, "max": 260, "step": 10, "default": 140 },
    { "type": "range", "id": "card_image_height", "label": "Product card image height (px)", "min": 60, "max": 240, "step": 10, "default": 90 },
    { "type": "select", "id": "card_image_mode", "label": "Product card image style", "options": [{ "value": "fixed", "label": "Fixed height" }, { "value": "square", "label": "Full width square" }], "default": "fixed" },
    { "type": "select", "id": "mobile_grid_cols", "label": "Product columns on mobile", "options": [{ "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" }], "default": "2" },
    { "type": "select", "id": "image_fit", "label": "Product image fit", "options": [{ "value": "cover", "label": "Cover (crop)" }, { "value": "contain", "label": "Contain (letterbox)" }, { "value": "fill", "label": "Fill (stretch)" }], "default": "cover" },
    { "type": "checkbox", "id": "show_card_benefits", "label": "Show benefit bullets on cards", "default": true },
    { "type": "header", "content": "Deal & size selector style" },
    { "type": "color", "id": "selector_bg_color", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "selector_selected_bg_color", "label": "Selected button background", "default": "#0a0a0a" },
    { "type": "color", "id": "selector_selected_text_color", "label": "Selected button text / icon color", "default": "#ffffff" },
    { "type": "color", "id": "selector_selected_border_color", "label": "Selected button border color", "default": "#0a0a0a" },
    { "type": "range", "id": "selector_selected_border_width", "label": "Selected button border width (px)", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "header", "content": "Product card colors" },
    { "type": "color", "id": "card_body_bg_color", "label": "Card body background", "default": "#ffffff" },
    { "type": "header", "content": "Add button style" },
    { "type": "color", "id": "add_btn_bg_color", "label": "Add button background", "default": "#0a0a0a" },
