          <h3>{{ section.settings.products_heading }}</h3>
          <span id="{{ section_id }}-bandssub"></span>
        </div>
{%- if section.settings.show_filters -%}
        <div class="bb-filters" id="{{ section_id }}-filters"></div>
        {%- endif -%}
