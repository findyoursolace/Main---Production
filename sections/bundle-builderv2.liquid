{% comment %}
  Bundle Builder Section v3
  Mobile-first horizontal deal rows, custom size/watch icons, size guide modal
{% endcomment %}

{%- liquid
  assign section_id = 'bundle-builder-' | append: section.id
  assign deal_1_enabled = section.settings.deal_1_enabled
  assign deal_3_enabled = section.settings.deal_3_enabled
  assign deal_5_enabled = section.settings.deal_5_enabled
  assign show_prices    = section.settings.show_prices

  assign first_product = blank
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank and first_product == blank
      assign first_product = block.settings.product
    endif
  endfor
-%}

