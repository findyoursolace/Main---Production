  <div class="bb-checkout">
    <div class="bb-inner">
      <div class="bb-cb-top">
        <div><div class="bb-cb-deal" id="{{ section_id }}-cbdeal"></div><div id="{{ section_id }}-cbperk"></div></div>
        <div class="bb-cb-price-wrap"><div class="bb-cb-price" id="{{ section_id }}-cbprice"></div><div id="{{ section_id }}-cbwas"></div></div>
      </div>
      <div class="bb-progress-wrap is-hidden" id="{{ section_id }}-progwrap">
        <div class="bb-prog-labels"><span id="{{ section_id }}-progleft"></span><span id="{{ section_id }}-progright"></span></div>
        <div class="bb-prog-track"><div class="bb-prog-fill" id="{{ section_id }}-progfill"></div></div>
      </div>
      <button class="bb-cta" id="{{ section_id }}-cta" disabled>{{ section.settings.cta_initial_label }}</button>
