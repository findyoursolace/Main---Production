      <div class="bb-bands-section">
        <div class="bb-section-head" style="padding: 0 0 0 0; margin-bottom: 10px;">
          {%- if section.settings.show_step_tags -%}<div class="bb-step-tag">{{ section.settings.step3_tag }}</div>{%- endif -%}
