  {%- if section.settings.show_size_guide -%}
          <button class="bb-size-guide-link" id="{{ section_id }}-size-guide-btn">{{ section.settings.size_guide_link_text }}</button>
          {%- endif -%}
          {%- endif -%}
        </div>
