{%- style -%}
  .custom-hero {
    {%- if section.settings.bg_mode == 'gradient' -%}
      background-image: linear-gradient(
        {{ section.settings.gradient_angle }}deg,
        {{ section.settings.gradient_color_1 }} {{ section.settings.gradient_stop_1 }}%,
        {{ section.settings.gradient_color_2 }} {{ section.settings.gradient_stop_2 }}%
      );
      background-color: transparent;
      background-repeat: no-repeat;
      background-size: cover;
    {%- else -%}
      background-color: {{ section.settings.bg_color }};
      background-image: none;
    {%- endif -%}

    display: flex;
    flex-direction: column;
    padding-top: {{ section.settings.mobile_section_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_section_padding_bottom }}px;
  }

  .hero-content-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width:120rem;
    margin:0 auto;
  }

  h2 {
  font-weight: 600;
}

  @media screen and (max-width: 749px) {
    .hero-content-wrapper.mobile-image-first {
      flex-direction: column-reverse;
    }
  }

  .hero-text-side {
    padding: {{ section.settings.mobile_text_padding_y }}px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .hero-subheading {
    font-size: {{ section.settings.mobile_subheading_size }}px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color }};
    margin-bottom:15px;
  font-weight: 600;
  }

  .hero-title {
    font-size: {{ section.settings.mobile_title_size }}px;
    line-height: 1.1;
    margin: 0 0 15px;
    color: {{ section.settings.title_color }};
    max-width: 500px;
    font-weight: 600;
  }

  .hero-description {
    font-size: {{ section.settings.mobile_description_size }}px;
    line-height: 1.5;
    margin-bottom: 20px;
    max-width: 450px;
    color: {{ section.settings.description_color }};
  }

  .hero-buttons {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
    align-items: center;
  }

  .hero-btn {
    text-decoration: none;
    padding: 15px 35px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 280px;
    transition: opacity 0.3s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background-color: {{ section.settings.btn1_bg }};
    color: {{ section.settings.btn1_text }};
  }

  .btn-secondary {
    background-color: {{ section.settings.btn2_bg }};
    color: {{ section.settings.btn2_text }};
  }

  .hero-image-side {
    width: 100%;
    line-height: 0;
    height: {{ section.settings.mobile_img_height }}px;
    overflow: hidden;
    display: block;
    position: relative;
  }

  .hero-image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media screen and (min-width: 750px) {
    .custom-hero {
      padding-top: {{ section.settings.desktop_section_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_section_padding_bottom }}px;
    }

    .hero-content-wrapper {
      flex-direction: row;
      min-height: {{ section.settings.desktop_min_height }}px;
    }

    .hero-content-wrapper.mobile-image-first {
      flex-direction: row;
    }

    .hero-text-side {
      width: {{ section.settings.desktop_content_width }}%;
      padding: {{ section.settings.desktop_text_padding_y }}px 5%;
      text-align: left;
      align-items: flex-start;
      max-width: none;
    }

    .hero-image-side {
      width: {{ 100 | minus: section.settings.desktop_content_width }}%;
      height: auto;
      max-height: {{ section.settings.desktop_img_max_height }}px;
      overflow: hidden;
    }

    .hero-image-side img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .hero-subheading {
      font-size: {{ section.settings.desktop_subheading_size }}px;
    }

    .hero-title {
      font-size: {{ section.settings.desktop_title_size }}px;
      max-width: 100%;
    }

    .hero-description {
      font-size: {{ section.settings.desktop_description_size }}px;
    }

    .hero-buttons {
      flex-direction: row;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .hero-btn {
      width: auto;
    }
  }
{%- endstyle -%}

{% assign desktop_image_width = 100 | minus: section.settings.desktop_content_width %}
{% capture hero_sizes %}
(max-width: 749px) 100vw, {{ desktop_image_width }}vw
{% endcapture %}

<section class="custom-hero">
  <div class="hero-content-wrapper {% if section.settings.mobile_image_above_text %}mobile-image-first{% endif %}">
    <div class="hero-text-side">

      {% if section.settings.subheading != blank %}
        <p class="hero-subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="hero-title">
          {% render 'highlight-brackets',
          text: section.settings.title,
          class: 'section-title-highlight'
         %}
         </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hero-description">{{ section.settings.description }}</div>
      {% endif %}

      <div class="hero-buttons">
        {% if section.settings.btn1_label != blank %}
          <a href="{{ section.settings.btn1_link }}" class="hero-btn btn-primary">
            {{ section.settings.btn1_label }} &nbsp; →
          </a>
        {% endif %}

        {% if section.settings.btn2_label != blank %}
          <a href="{{ section.settings.btn2_link }}" class="hero-btn btn-secondary">
            {{ section.settings.btn2_label }} &nbsp; →
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.btn1_link != blank %}
      <a href="{{ section.settings.btn1_link }}" class="hero-image-side" aria-label="{{ section.settings.btn1_label | escape }}">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '480, 640, 750, 960, 1200, 1600, 2000',
              sizes: hero_sizes,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </a>
    {% else %}
      <div class="hero-image-side">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '480, 640, 750, 960, 1200, 1600, 2000',
              sizes: hero_sizes,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Split Hero Banner",
  "settings": [

    { "type": "header", "content": "Layout Controls" },

    {
      "type": "checkbox",
      "id": "mobile_image_above_text",
      "label": "Mobile: Image Above Text",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_content_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Desktop Text Column Width",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_min_height",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Desktop Section Min-Height",
      "default": 600
    },
    {
      "type": "range",
      "id": "desktop_text_padding_y",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Text Padding (Top/Bottom)",
      "default": 28
    },
    {
      "type": "range",
      "id": "desktop_img_max_height",
      "min": 150,
      "max": 900,
      "step": 25,
      "unit": "px",
      "label": "Desktop Image Max Height",
      "default": 525
    },
    {
      "type": "range",
      "id": "mobile_text_padding_y",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Text Padding (Top/Bottom)",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_img_height",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Mobile Image Height",
      "default": 400
    },

    { "type": "header", "content": "Section Padding — Desktop" },

    {
      "type": "range",
      "id": "desktop_section_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Section Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_section_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Section Padding Bottom",
      "default": 0
    },

    { "type": "header", "content": "Section Padding — Mobile" },

    {
      "type": "range",
      "id": "mobile_section_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Section Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_section_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Section Padding Bottom",
      "default": 0
    },

    { "type": "header", "content": "Background" },

    {
      "type": "select",
      "id": "bg_mode",
      "label": "Background Type",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#B8C9DE"
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient Color 1",
      "default": "#B8C9DE"
    },
    {
      "type": "range",
      "id": "gradient_stop_1",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Color 1 Stop",
      "default": 0
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient Color 2",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "gradient_stop_2",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Color 2 Stop",
      "default": 100
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "label": "Gradient Angle",
      "default": 135
    },

    { "type": "header", "content": "Colors" },

    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#121212"
    },

    { "type": "header", "content": "Font Sizes — Desktop" },

    {
      "type": "range",
      "id": "desktop_subheading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop Subheading Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "desktop_title_size",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Desktop Heading Font Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "desktop_description_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Desktop Description Font Size",
      "default": 16
    },

    { "type": "header", "content": "Font Sizes — Mobile" },

    {
      "type": "range",
      "id": "mobile_subheading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile Subheading Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Mobile Heading Font Size",
      "default": 38
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Mobile Description Font Size",
      "default": 16
    },

    { "type": "header", "content": "Content" },

    { "type": "image_picker", "id": "image", "label": "Banner Image" },

    { "type": "text", "id": "subheading", "label": "Subheading", "default": "1.5M+ BANDS SOLD | 15K+ 5-STAR REVIEWS" },
    { "type": "text", "id": "title", "label": "Heading", "default": "An Apple Watch Premium Upgrade" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Just launched: new limited time color options for our best-selling Imperium Adapt smart watch band.</p>" },

    { "type": "header", "content": "Button 1" },
    { "type": "text", "id": "btn1_label", "label": "Button 1 Label", "default": "Shop Now" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 Link" },
    { "type": "color", "id": "btn1_bg", "label": "Button 1 BG", "default": "#263636" },
    { "type": "color", "id": "btn1_text", "label": "Button 1 Text", "default": "#FFFFFF" },

    { "type": "header", "content": "Button 2" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 Label", "default": "Shop All Bands" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 Link" },
    { "type": "color", "id": "btn2_bg", "label": "Button 2 BG", "default": "#F7E5C1" },
    { "type": "color", "id": "btn2_text", "label": "Button 2 Text", "default": "#121212" }
  ],
  "presets": [
    { "name": "Split Hero Banner" }
  ]
}
{% endschema %}