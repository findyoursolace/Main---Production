<div id="solace-transition-{{ section.id }}" class="solace-transition-wrapper">
  <style>
    /* 1. SCOPED RESET */
    #solace-transition-{{ section.id }} {
      all: unset;
      display: block;
      position: relative;
      background-color: #0f172a; /* Slate-900 */
      padding: 120px 24px;
      text-align: center;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      box-sizing: border-box;
    }
    #solace-transition-{{ section.id }} * { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
    }

    @media (min-width: 768px) {
      #solace-transition-{{ section.id }} { padding: 180px 48px; }
    }

    /* 2. BACKGROUND ACCENTS */
    .solace-bg-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 600px;
      height: 600px;
      background: #2563eb; /* Blue-600 */
      filter: blur(150px);
      border-radius: 50%;
      opacity: 0.2;
      pointer-events: none;
      z-index: 1;
    }

    /* 3. CONTENT CONTAINER */
    .solace-transition-container {
      max-width: 896px; /* Max-w-4xl */
      margin: 0 auto !important;
      position: relative;
      z-index: 5;
    }

    /* 4. TYPOGRAPHY */
    .solace-trans-title {
      font-size: clamp(3rem, 10vw, 7.5rem); /* Responsive 5xl to 8xl */
      font-weight: 900;
      color: #ffffff !important;
      letter-spacing: -0.05em;
      line-height: 0.9;
      text-transform: uppercase;
      font-style: italic;
      margin-bottom: 32px;
    }

    .solace-trans-p {
      font-size: 1.125rem;
      color: #94a3b8; /* Slate-400 */
      font-weight: 500;
      line-height: 1.6;
      max-width: 650px;
      margin: 0 auto !important;
    }

    @media (min-width: 768px) {
      .solace-trans-p { font-size: 1.25rem; }
    }

    /* 5. CTA BUTTON */
    .solace-trans-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background-color: #ffffff !important;
      color: #0f172a !important;
      padding: 20px 48px !important;
      border-radius: 16px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 14px;
      text-decoration: none !important;
      transition: all 0.3s ease;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      cursor: pointer;
    }

    .solace-trans-cta:hover {
      background-color: #f1f5f9 !important;
      transform: translateY(-4px);
      box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.6);
    }
  </style>

  <div class="solace-bg-glow"></div>

  <div class="solace-transition-container">
    <h2 class="solace-trans-title">
      {{ section.settings.title }}
    </h2>
    
    <p class="solace-trans-p">
      {{ section.settings.subtitle }}
    </p>

    {% if section.settings.show_cta %}
      <div style="margin-top: 32px;">
        <a href="{{ section.settings.link }}" class="solace-trans-cta">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>
<div id="prodanchor"></div>

{% schema %}
{
  "name": "Solace Transition",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "HAD ENOUGH?" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Your health shouldn't be a byproduct of your tech." },
    { "type": "checkbox", "id": "show_cta", "label": "Show Button", "default": false },
    { "type": "text", "id": "cta_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Solace Transition" }]
}
{% endschema %}