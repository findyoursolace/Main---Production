{% doc %}
  @prompt
    Inline Text links that filter the products based on the "Watch Type" product option, instead of product option, I want to use the "Watch Type" product metafield (actually add a dynamic metafield picker)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-watch-filter-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-watch-filter-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: {{ block.settings.gap }}px;
  }

  .ai-watch-filter-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    margin: 0;
  }

  .ai-watch-filter-links-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.link_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-watch-filter-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_decoration }};
    transition: color 0.2s ease, text-decoration 0.2s ease;
  }

  .ai-watch-filter-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration: {{ block.settings.link_hover_decoration }};
  }

  .ai-watch-filter-link-{{ ai_gen_id }}.active {
    color: {{ block.settings.active_link_color }};
    font-weight: {{ block.settings.active_link_weight }};
    text-decoration: {{ block.settings.active_link_decoration }};
  }

  .ai-watch-filter-separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.link_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-watch-filter-container-{{ ai_gen_id }} {
      gap: {{ block.settings.gap | times: 0.8 }}px;
    }

    .ai-watch-filter-links-{{ ai_gen_id }} {
      gap: {{ block.settings.link_gap | times: 0.8 }}px;
    }

    .ai-watch-filter-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }

    .ai-watch-filter-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_size | times: 0.9 }}px;
    }

    .ai-watch-filter-separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<watch-type-filter-{{ ai_gen_id }}
  class="ai-watch-filter-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-watch-filter-container-{{ ai_gen_id }}">
    {% if block.settings.show_label %}
      <h3 class="ai-watch-filter-label-{{ ai_gen_id }}">{{ block.settings.label_text }}</h3>
    {% endif %}

    <ul class="ai-watch-filter-links-{{ ai_gen_id }}">
      {% if block.settings.show_all_option %}
        <li>
          <a
            href="{{ block.settings.all_link }}"
            class="ai-watch-filter-link-{{ ai_gen_id }}"
            data-filter="all"
          >
            {{ block.settings.all_text }}
          </a>
        </li>
        {% if block.settings.show_separator %}
          <li class="ai-watch-filter-separator-{{ ai_gen_id }}" aria-hidden="true">{{ block.settings.separator_text }}</li>
        {% endif %}
      {% endif %}

      {% for i in (1..5) %}
        {% assign watch_type_key = 'watch_type_' | append: i %}
        {% assign watch_label_key = 'watch_label_' | append: i %}
        {% assign watch_enabled_key = 'watch_enabled_' | append: i %}

        {% assign watch_type = block.settings[watch_type_key] %}
        {% assign watch_label = block.settings[watch_label_key] %}
        {% assign watch_enabled = block.settings[watch_enabled_key] %}

        {% if watch_enabled and watch_type != blank %}
          {% if block.settings.metafield_namespace != blank and block.settings.metafield_key != blank %}
            {% assign filter_param = block.settings.metafield_namespace | append: '.' | append: block.settings.metafield_key %}
            <li>
              <a
                href="?filter.v.m.{{ filter_param }}={{ watch_type | url_encode }}"
                class="ai-watch-filter-link-{{ ai_gen_id }}"
                data-filter="{{ watch_type | handleize }}"
              >
                {% if watch_label != blank %}
                  {{ watch_label }}
                {% else %}
                  {{ watch_type }}
                {% endif %}
              </a>
            </li>
          {% endif %}
          {% if block.settings.show_separator and forloop.last == false %}
            <li class="ai-watch-filter-separator-{{ ai_gen_id }}" aria-hidden="true">{{ block.settings.separator_text }}</li>
          {% endif %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</watch-type-filter-{{ ai_gen_id }}>

<script>
  (function() {
    class WatchTypeFilter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.links = this.querySelectorAll('.ai-watch-filter-link-{{ ai_gen_id }}');
        this.setActiveLink();
        this.setupEventListeners();
      }

      setActiveLink() {
        const urlParams = new URLSearchParams(window.location.search);
        
        this.links.forEach((link) => {
          link.classList.remove('active');
        });

        let activeFilterFound = false;
        this.links.forEach((link) => {
          const linkUrl = new URL(link.href, window.location.origin);
          const linkParams = new URLSearchParams(linkUrl.search);
          
          for (let [key, value] of linkParams.entries()) {
            if (key.startsWith('filter.v.m.') && urlParams.get(key) === value) {
              link.classList.add('active');
              activeFilterFound = true;
            }
          }
        });

        if (!activeFilterFound) {
          const allLink = this.querySelector('[data-filter="all"]');
          if (allLink) {
            allLink.classList.add('active');
          }
        }
      }

      setupEventListeners() {
        this.links.forEach((link) => {
          link.addEventListener('click', (event) => {
            this.links.forEach((l) => l.classList.remove('active'));
            link.classList.add('active');
          });
        });
      }
    }

    customElements.define('watch-type-filter-{{ ai_gen_id }}', WatchTypeFilter{{ ai_gen_id }});
  })();
</script>

