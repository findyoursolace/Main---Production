{% unless product_option.available %}
  <svg
    viewBox="0 0 100 46"
    preserveAspectRatio="xMidYMid slice"
  >
    <rect
      x="0"
      y="0"
      width="100"
      height="46"
      fill="white"
      fill-opacity="0.7"
    />

    <!-- strike-through line -->
    <line
      x1="100"
      y1="0"
      x2="0"
      y2="46"
      stroke="#1d1c1c"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />

    <!-- duplicate line -->
    <line
      x1="100"
      y1="0"
      x2="0"
      y2="46"
      stroke="#1d1c1c"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />
  </svg>
{% endunless %}