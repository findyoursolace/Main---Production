<div class="watch-compatibility-wrapper">
    <button type="button" 
            class="size-guide-trigger watchCompatibility button button--secondary openCompatibility active" 
            data-variants="{{ product.variants | map: 'id' | json | escape }}"
            style="width: 100%;">
        Check Watch Compatibility
    </button>

    <div class="watchInfo" style="display:none; padding: 10px; border: 1px solid #eee; border-radius: 8px;">
        <div class="watchInfoTitle">
            Your Watch: <span class="watchInfoTitleName" style="font-weight: bold;"></span>
        </div>
        <div class="watchInfoControls" style="margin-top: 5px;">
            <button type="button" class="watchInfoControlsItem change" style="text-decoration: underline; background: none; border: none; cursor: pointer; padding: 0; font-size: 12px;">change</button>
            <span style="font-size: 12px;"> | </span>
            <button type="button" class="watchInfoControlsItem remove" style="text-decoration: underline; background: none; border: none; cursor: pointer; padding: 0; font-size: 12px;">remove</button>
        </div>
    </div>
</div>