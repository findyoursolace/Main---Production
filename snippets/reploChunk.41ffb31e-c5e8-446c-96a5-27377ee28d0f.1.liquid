<div class="timer" aria-live="polite" aria-label="Countdown to midnight">
  <div class="unit"><div id="d" class="value">0</div><div class="label">Days</div></div>
  <div class="sep">:</div>
  <div class="unit"><div id="h" class="value">00</div><div class="label">Hours</div></div>
  <div class="sep">:</div>
  <div class="unit"><div id="m" class="value">00</div><div class="label">Minutes</div></div>
  <div class="sep">:</div>
  <div class="unit"><div id="s" class="value">00</div><div class="label">Seconds</div></div>
</div>

<script>
(function () {
  const el = {
    d: document.getElementById('d'),
    h: document.getElementById('h'),
    m: document.getElementById('m'),
    s: document.getElementById('s'),
  };

  // returns Date for the next local midnight (i.e., the start of the next day)
  function nextMidnight() {
    const t = new Date();
    // set to tomorrow 00:00:00.000, robust across DST changes
    t.setHours(24, 0, 0, 0);
    return t;
  }

  let deadline = nextMidnight();

  function pad(n) { return String(n).padStart(2, '0'); }

  function tick() {
    const now = new Date();
    let ms = deadline - now;

    // If we've crossed midnight (ms <= 0), roll to the *next* midnight
    if (ms <= 0) {
      deadline = nextMidnight();
      ms = deadline - now;
    }

    const totalSeconds = Math.floor(ms / 1000);
    const days = Math.floor(totalSeconds / 86400); // usually 0, but shown as requested
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    el.d.textContent = days;
    el.h.textContent = pad(hours);
    el.m.textContent = pad(minutes);
    el.s.textContent = pad(seconds);
  }

  tick(); // initial paint
  setInterval(tick, 1000);
})();
</script>

