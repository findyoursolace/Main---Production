<script>
  function updateLowStockMessage(picker, variant) {
    if (!picker || !variant) return;

    const container = picker.querySelector('.variant-low-stock-message');
    if (!container) return;

    const qty = Number(variant.inventory_quantity);

    if (qty >= 1 && qty <= 75) {
      container.textContent = `🔥 Only ${qty} left in stock, buy now before you miss out!`;
      container.style.display = 'block';
    } else {
      container.textContent = '';
      container.style.display = 'none';
    }
  }

  document.addEventListener('variant:change', function(event) {
    const picker = event.target.closest('variant-picker') || document.querySelector('variant-picker');
    if (picker && event.detail && event.detail.variant) {
      updateLowStockMessage(picker, event.detail.variant);
    }
  });
</script>