{% comment %}
  Trust USP Icons — SVG coloring via CSS Masks
{% endcomment %}

{% assign section_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .trust-usp-{{ section_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .trust-usp-container-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0px, max-content));
    justify-content: flex-start;
    gap: {{ block.settings.gap }}px;
    max-width: 100%;
  }

  .trust-usp-item-{{ section_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    text-align: left;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .trust-usp-icon-wrapper-{{ section_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: left;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
    flex-shrink: 0;
  }

  .trust-usp-icon-{{ section_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.icon_color }};
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .trust-usp-icon-placeholder-{{ section_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trust-usp-icon-placeholder-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
    stroke: {{ block.settings.icon_color }};
  }

  .trust-usp-text-{{ section_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.2;
    word-break: break-word;
  }

  @media screen and (max-width: 749px) {
    .trust-usp-container-{{ section_id }} {
      grid-template-columns: repeat(3, minmax(0px, max-content));
      gap: {{ block.settings.gap_mobile }}px;
    }

    .trust-usp-icon-wrapper-{{ section_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .trust-usp-text-{{ section_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="trust-usp-{{ section_id }}" {{ block.shopify_attributes }}>
  <div class="trust-usp-container-{{ section_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign icon_key = 'icon_' | append: i
        assign text_key = 'text_' | append: i
        assign icon = block.settings[icon_key]
        assign text = block.settings[text_key]
      %}

      {% if icon != blank or text != blank %}
        <div class="trust-usp-item-{{ section_id }}">
          <div class="trust-usp-icon-wrapper-{{ section_id }}">
            {% if icon != blank %}
              <div
                class="trust-usp-icon-{{ section_id }}"
                role="img"
                aria-label="{{ text | escape }}"
                style="-webkit-mask-image: url({{ icon | image_url: width: 200 }}); mask-image: url({{ icon | image_url: width: 200 }});"
              ></div>
            {% else %}
              <div class="trust-usp-icon-placeholder-{{ section_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
            {% endif %}
          </div>

          {% if text != blank %}
            <div class="trust-usp-text-{{ section_id }}">{{ text }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust USP icons",
  "settings": [
    {
      "type": "header",
      "content": "USP 1"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icon (SVG recommended)"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text",
      "default": "Free Shipping"
    },
    {
      "type": "header",
      "content": "USP 2"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text",
      "default": "30-Day Returns"
    },
    {
      "type": "header",
      "content": "USP 3"
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text",
      "default": "Secure Checkout"
    },
    {
      "type": "header",
      "content": "USP 4"
    },
    {
      "type": "image_picker",
      "id": "icon_4",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Text",
      "default": "24/7 Support"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
