      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Gap between icon and text",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
